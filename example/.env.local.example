# Machine-local configuration for the example agent.
# Copy to .env.local (gitignored) and fill in what you need; every variable is
# optional and overrides the repo-root .env. Defaults shown below.

# ── secrets (usually set in ../.env instead) ──────────────────────────────
# Anthropic API key — needed to run the agent itself (not the tests).
#ANTHROPIC_API_KEY=sk-ant-...
# 1Password service account with read+write access to the vault below —
# needed for the registry and the integration tests.
#OP_SERVICE_ACCOUNT_TOKEN=ops_...

# ── settings ──────────────────────────────────────────────────────────────
# Python logging level for the identity flow and tool events — applies to the
# program and to pytest's live log output alike.
# DEBUG adds CLI timings, the inferred Cedar mandate, and vault resolution.
#LOG_LEVEL=INFO

# pydantic-ai model string for the agent.
#AGENT_MODEL=anthropic:claude-haiku-4-5

# 1Password vault that holds one item per registered agent.
#OVID_VAULT_TITLE=OVID Agents

# Lifetime of each minted root token, in seconds.
#OVID_TTL_SECONDS=1800
